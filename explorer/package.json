{
  "name": "psilocin-transcriptomics-explorer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "observable preview --host 127.0.0.1",
    "build": "observable build && node scripts/prepare-site.mjs && node scripts/prepare-offline.mjs",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser-check.mjs",
    "test:print": "node test/print-check.mjs",
    "test:fullscreen": "node test/fullscreen-check.mjs",
    "test:tree": "node test/tree-browser-check.mjs",
    "test:network": "node test/network-browser-check.mjs",
    "test:comparison": "node test/comparison-browser-check.mjs",
    "prebuild": "node scripts/prepare-ui.mjs && node scripts/prepare-plots.mjs && node scripts/prepare-molecules.mjs && node scripts/prepare-atlas.mjs",
    "predev": "node scripts/prepare-ui.mjs && node scripts/prepare-plots.mjs && node scripts/prepare-molecules.mjs && node scripts/prepare-atlas.mjs",
    "test:app": "node test/app-shell-browser-check.mjs",
    "test:tour": "node test/tour-browser-check.mjs",
    "test:plot-theme": "node test/plot-theme-browser-check.mjs",
    "test:figures": "node test/figure-controls-browser-check.mjs",
    "test:icons": "node test/icon-ui-browser-check.mjs",
    "test:suggestions": "node test/pathway-autocomplete-browser-check.mjs",
    "test:analysis-fab": "node test/analysis-fab-browser-check.mjs",
    "test:plot-coverage": "node test/plot-coverage-browser-check.mjs",
    "test:research-additions": "node test/research-additions-browser-check.mjs",
    "test:progress": "node test/app-progress-browser-check.mjs",
    "test:downloads": "node test/download-confirmation-browser-check.mjs",
    "test:navigation-touch": "node test/navigation-touch-browser-check.mjs",
    "test:plot-system": "node test/plot-system-browser-check.mjs",
    "test:evidence": "node test/evidence-sheet-browser-check.mjs",
    "test:choices": "node test/smart-select-browser-check.mjs",
    "test:layout": "node test/plot-layout-browser-check.mjs",
    "test:annotations": "node test/gene-annotation-browser-check.mjs",
    "test:proteins": "node test/protein-context-browser-check.mjs",
    "test:pwa": "node test/pwa-browser-check.mjs",
    "test:tables": "node test/research-tables-browser-check.mjs",
    "test:molecular-previews": "node test/molecular-previews-browser-check.mjs",
    "test:custom-r": "node test/custom-r-browser-check.mjs",
    "test:r-reports": "node test/r-report-browser-check.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@observablehq/framework": "1.13.4",
    "@observablehq/plot": "0.6.19",
    "3dmol": "2.5.5",
    "codemirror": "6.0.2",
    "d3-chord": "3.0.1",
    "d3-force": "3.0.0",
    "d3-hexbin": "0.2.2",
    "d3-hierarchy": "3.1.2",
    "d3-shape": "3.2.0",
    "fflate": "0.8.3",
    "framework7": "9.3.0",
    "framework7-icons": "5.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "esbuild": "0.28.1",
    "html-minifier-terser": "7.2.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
