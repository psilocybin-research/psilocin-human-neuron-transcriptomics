{
  "name": "psilocin-transcriptomics-explorer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "observable preview --host 127.0.0.1",
    "build": "observable build && node scripts/prepare-site.mjs",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser-check.mjs",
    "test:print": "node test/print-check.mjs",
    "test:fullscreen": "node test/fullscreen-check.mjs",
    "test:tree": "node test/tree-browser-check.mjs",
    "test:network": "node test/network-browser-check.mjs",
    "test:comparison": "node test/comparison-browser-check.mjs",
    "prebuild": "node scripts/prepare-ui.mjs",
    "predev": "node scripts/prepare-ui.mjs",
    "test:app": "node test/app-shell-browser-check.mjs",
    "test:tour": "node test/tour-browser-check.mjs",
    "test:plot-theme": "node test/plot-theme-browser-check.mjs",
    "test:figures": "node test/figure-controls-browser-check.mjs"
  },
  "dependencies": {
    "@observablehq/framework": "1.13.4",
    "d3-chord": "3.0.1",
    "d3-force": "3.0.0",
    "d3-shape": "3.2.0",
    "framework7": "9.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "esbuild": "0.28.1"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
